{
  "info": {
    "_postman_id": "b7f1c2d4-5a6e-4c11-9d2f-3e8a7c001001",
    "name": "底座登录+访问",
    "description": "由截图重建：获取验证码 -> 登录 -> 业务接口",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "获取code接口",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json().data;",
              "pm.environment.set(\"uuid\", d.uuid);",
              "",
              "pm.visualizer.set(",
              "  '<div style=\"padding:12px\"><img src=\"data:image/jpeg;base64,{{{img}}}\" ' +",
              "  'style=\"width:150px;border:1px solid #ccc;border-radius:4px\"></div>',",
              "  { img: d.img }",
              ");",
              "",
              "console.log(\"uuid 已保存: \" + d.uuid);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://10.201.1.240/gateway/code",
          "protocol": "http",
          "host": ["10", "201", "1", "240"],
          "path": ["gateway", "code"]
        }
      },
      "response": []
    },
    {
      "name": "登录接口",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "",
              "if (res.success && res.data) {",
              "  const t = typeof res.data === \"string\" ? res.data : (res.data.token || \"\");",
              "  pm.environment.set(\"token\", t);",
              "  console.log(\"token 已保存: \" + t.slice(0, 24) + \"...\");",
              "} else {",
              "  console.log(\"登录失败: \" + res.message);",
              "}",
              "",
              "pm.test(\"登录成功\", function () {",
              "  pm.expect(res.success).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"account\": \"dataSync\",\n  \"code\": \"{{captcha}}\",\n  \"password\": \"dataSync@2021\",\n  \"ldapStatus\": 0,\n  \"tenantCode\": \"master\",\n  \"uuid\": \"{{uuid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://10.201.1.240/gateway/authx/auth/login",
          "protocol": "http",
          "host": ["10", "201", "1", "240"],
          "path": ["gateway", "authx", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "实验六算法查询接口",
      "event": [],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://10.201.1.240/gateway/system/navigation-group/list",
          "protocol": "http",
          "host": ["10", "201", "1", "240"],
          "path": ["gateway", "system", "navigation-group", "list"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "token", "value": "", "type": "string" },
    { "key": "uuid", "value": "", "type": "string" },
    { "key": "captcha", "value": "", "type": "string" }
  ]
}
